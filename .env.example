# ========================================================
# Darshan-OS 4.0 (Next.js) Environment Variables
# ========================================================

# Application Mode & Port
NODE_ENV=production
PORT=3000

# Groq LLM API Key (powers multi-turn conversational AI Copilot)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/darshan-os

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
ADMIN_PASSKEY=admin123

# Email Notifications (Nodemailer Gmail SMTP)
CONTACT_EMAIL=pdarshan2224@gmail.com
CONTACT_EMAIL_PASS=your_gmail_app_password_here
